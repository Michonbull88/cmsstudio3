{
  "name": "studio-cms",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Studio CMS with authenticated SQLite storage and server-side publishing",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "start": "node server/index.js",
